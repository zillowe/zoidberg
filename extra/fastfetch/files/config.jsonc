// System-wide fastfetch config for Parlex Linux, installed by Zoidberg's
// fastfetch package. A config in ~/.config/fastfetch/ replaces this one.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Found in /usr/share/fastfetch/logos/: "parlex.txt" is drawn with
    // block characters, "parlex-ascii.txt" with plain ASCII (#, %, @) for
    // fonts without block characters. Both use the same three colors.
    "source": "parlex.txt",
    "color": {
      "1": "#F5EFEF",
      "2": "#FDDFDD",
      "3": "#FFC7C3"
    }
  },
  "display": {
    "color": {
      "keys": "#7B79FF",
      "title": "#7B79FF"
    }
  },
  // fastfetch's default module list (DEFAULT_STRUCTURE): a config file
  // without "modules" would print no information at all.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
