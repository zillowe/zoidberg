Make tarballs created by automake-generated "make dist" reproducible
(sorted names, fixed mtime and owner). Taken from Arch Linux's automake
package, refreshed for automake 1.20.

--- a/m4/tar.m4
+++ b/m4/tar.m4
@@ -89,8 +89,8 @@
           ($_am_tar --version) 2>&1 | grep -i busybox >/dev/null || break
         fi
       done
-      am__tar="$_am_tar --format=m4_if([$1], [pax], [posix], [$1]) -chf - "'"$$tardir"'
-      am__tar_="$_am_tar --format=m4_if([$1], [pax], [posix], [$1]) -chf - "'"$tardir"'
+      am__tar="$_am_tar --format=m4_if([$1], [pax], [posix], [$1]) --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -chf - "'"$$tardir"'
+      am__tar_="$_am_tar --format=m4_if([$1], [pax], [posix], [$1]) --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -chf - "'"$tardir"'
       am__untar="$_am_tar -xf -"
       ;;
     plaintar)
